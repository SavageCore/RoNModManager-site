---
const base = import.meta.env.BASE_URL;
---

<header class="ron-header">
  <nav aria-label="Primary">
    <a class="ron-wordmark" href={base}>
      RoN Mod Manager
    </a>
    <ul>
      <li>
        <a href={`${base}downloads/`}>Downloads</a>
      </li>
      <li>
        <a href={`${base}docs/`}>Docs</a>
      </li>
      <li>
        <a
          href="https://github.com/SavageCore/RoNModManager"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .ron-header {
    border-bottom: 1px solid var(--ron-border);
    background: var(--ron-background);
  }
  .ron-header nav {
    max-width: var(--ron-max-width);
    margin: 0 auto;
    padding: 0.75rem var(--ron-space);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ron-wordmark {
    font-family: var(--ron-font-display);
    font-weight: 700;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--ron-text);
    border-left: 3px solid var(--ron-accent);
    padding-left: 0.6rem;
  }
  .ron-wordmark:hover {
    color: var(--ron-text);
    background: transparent;
  }
  .ron-header ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ron-header ul a {
    font-family: var(--ron-font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  @media (max-width: 28rem) {
    .ron-header nav {
      gap: 0.5rem;
      padding: 0.75rem 0.5rem;
    }
    .ron-header ul {
      gap: 0.6rem;
    }
    .ron-wordmark {
      font-size: 1rem;
      padding-left: 0.4rem;
    }
  }
</style>
